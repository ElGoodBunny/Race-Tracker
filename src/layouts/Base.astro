---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Where the course comes from (course.source of the race). Only race pages have one. */
  source?: string;
  /** Social preview image, path under public/ (e.g. /data/hamburg-2026/og.png), 1200x630. */
  image?: string;
  /** Title for link previews (WhatsApp etc.) when it should differ from <title>. */
  ogTitle?: string;
}
const { title, description, noindex = true, source, image, ogTitle } = Astro.props;
// astro.config.mjs still has a placeholder site. Absolute URLs only once the real domain is set.
const site = Astro.site && Astro.site.hostname !== "example.com" ? Astro.site : undefined;
const pageUrl = site && new URL(Astro.url.pathname, site).href;
const imageUrl = site && image && new URL(image, site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <!-- same values as --bg in tokens.css -->
    <meta name="theme-color" content="#F5F5F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Zum Inhalt</a>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap foot body-6 muted">
      {source && <span>Strecke: {source}. </span>}
      <span>Kartendaten © OpenStreetMap-Mitwirkende, ODbL.</span>
    </footer>
  </body>
</html>

<style is:global>
  .foot { padding-block: var(--s900) var(--s400); }
</style>
