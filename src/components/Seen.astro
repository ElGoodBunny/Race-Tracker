---
// "Ich sehe Dima gerade" (docs/tasks/026-claude-gesehen.md). Sits in the status card like in the legacy page
// (docs/tasks/027-claude-statuskarte.md). Shown only while Dima runs.
import GuestPrompt from "./GuestPrompt.astro";

interface Props {
  slug: string;
  plannedStart: string;
  targetSec: number;
  distanceKm: number;
  netSec?: number;
}
const { slug, plannedStart, targetSec, distanceKm, netSec } = Astro.props;
const plan = { plannedStart, targetSec, distanceKm, netSec };
---

<div class="live-sec seen-box" id="seen" data-slug={slug} data-plan={JSON.stringify(plan)} hidden>
  <button class="btn signal button-md" type="button" id="seen-btn">
    <svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M247.31,124.76c-.35-.79-8.82-19.58-27.65-38.41C194.57,61.26,162.88,48,128,48S61.43,61.26,36.34,86.35C17.51,105.18,9,124,8.69,124.76a8,8,0,0,0,0,6.5c.35.79,8.82,19.57,27.65,38.4C61.43,194.74,93.12,208,128,208s66.57-13.26,91.66-38.34c18.83-18.83,27.3-37.61,27.65-38.4A8,8,0,0,0,247.31,124.76ZM128,192c-30.78,0-57.67-11.19-79.93-33.25A133.47,133.47,0,0,1,25,128,133.33,133.33,0,0,1,48.07,97.25C70.33,75.19,97.22,64,128,64s57.67,11.19,79.93,33.25A133.46,133.46,0,0,1,231.05,128C223.84,141.46,192.43,192,128,192Zm0-112a48,48,0,1,0,48,48A48.05,48.05,0,0,0,128,80Zm0,80a32,32,0,1,1,32-32A32,32,0,0,1,128,160Z"></path></svg>
    <span>Ich sehe Dima gerade</span>
  </button>
  <p class="hint body-6" id="seen-hint" aria-live="polite">Ein Tipp macht die Schätzung für alle genauer.</p>
  <p class="err body-6" id="seen-err" role="alert" hidden></p>
  <GuestPrompt id="seen-guest" label="Wie heißt du? Der Name steht bei deiner Sichtung." submit="Speichern und melden" />
</div>

<script>
  import { startSeen } from "./seen";
  const root = document.getElementById("seen");
  if (root) startSeen(root);
</script>

<style>
  .seen-box { padding-top: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--s100); max-width: 560px; }
  .seen-box[hidden] { display: none; }
  .seen-box :global(.name-form) { align-self: stretch; }
</style>
