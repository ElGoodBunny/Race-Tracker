---
// Static SVG course map, rendered at build time. Works without JavaScript.
// On the race page it is the fallback when the 3D view does not run. Then course-map.ts adds runner, the part
// already run and the spots (docs/tasks/034-claude-karte.md). Tapping to set a spot happens in the 3D view.
import type { CollectionEntry } from "astro:content";
import { makeProjection, latLngAt, type LatLng } from "../lib/course";

interface Props {
  race: CollectionEntry<"races">["data"];
  /** Fill the box around it, without border and caption: placeholder of the 3D view on the race page. */
  fill?: boolean;
  /** Add the live layer. In the 3D placeholder only once the page reports that 3D does not run ("stage-fallback"). */
  live?: boolean;
}
const { race, fill = false, live = false } = Astro.props;
const plan = { plannedStart: race.plannedStart, targetSec: race.targetSec, distanceKm: race.distanceKm, netSec: race.result?.netSec };
const c = race.course;
const { vbw, vbh, project } = makeProjection(c.bounds);
const path = (pts: LatLng[], close = false) =>
  pts.map((p, i) => `${i ? "L" : "M"}${project(p).map((v) => v.toFixed(1)).join(",")}`).join("") + (close ? "Z" : "");

const routeD = path(c.route as LatLng[]);
const kmMarks = Array.from({ length: Math.floor(race.distanceKm) }, (_, i) => i + 1)
  .filter((k) => k % 5 === 0)
  .map((k) => ({ k, xy: project(latLngAt(c as never, k)) }));
const labels = c.landmarks
  .filter((l) => l.label)
  .map((l) => ({ ...l, xy: project(c.route[l.idx] as LatLng) }));
const start = project(c.route[0] as LatLng);
const finish = project(c.route[c.route.length - 1] as LatLng);
---

<figure class:list={["map", { fill }]} data-live-map={live ? "" : undefined} data-slug={race.slug} data-plan={live ? JSON.stringify(plan) : undefined} data-course={live ? JSON.stringify({ route: c.route, km: c.km, bounds: c.bounds }) : undefined}>
  <svg viewBox={`0 0 ${vbw} ${vbh}`} role="img" aria-label={`Strecke ${race.title}, ${race.distanceKm.toLocaleString("de-DE")} km`}>
    <rect width={vbw} height={vbh} fill="var(--land)" />
    {c.features.parks.map((p) => <path d={path(p as LatLng[], true)} fill="var(--park)" />)}
    {c.features.water.map((p) => <path d={path(p as LatLng[], true)} fill="var(--water)" stroke="var(--water-line)" stroke-width="1" />)}
    {c.features.canals.map((p) => <path d={path(p as LatLng[])} fill="none" stroke="var(--water)" stroke-width="6" stroke-linecap="round" />)}
    <path d={routeD} fill="none" stroke="var(--route-todo)" stroke-width="7" stroke-linejoin="round" stroke-linecap="round" />
    <path d={routeD} fill="none" stroke="var(--route)" stroke-width="3" stroke-linejoin="round" stroke-linecap="round" />
    {live && <path class="done" d="" fill="none" stroke="var(--route)" stroke-width="7" stroke-linejoin="round" stroke-linecap="round" />}
    {kmMarks.map(({ k, xy }) => (
      <g transform={`translate(${xy[0]},${xy[1]})`}>
        <circle r="11" fill="var(--route)" />
        <text class="mono" text-anchor="middle" dy="4" font-size="11" font-weight="600" fill="var(--route-ink)">{k}</text>
      </g>
    ))}
    <circle cx={start[0]} cy={start[1]} r="7" fill="var(--signal)" />
    <circle cx={finish[0]} cy={finish[1]} r="7" fill="var(--ink)" />
    {live && <g class="spots"></g>}
    {live && <g class="runner" visibility="hidden"><circle r="12" fill="var(--signal)" stroke="var(--surface)" stroke-width="3" /></g>}
    {labels.map((l) => (
      <text class:list={{ "wide-only": !l.mobile }} x={l.xy[0] + (l.dx ?? 0)} y={l.xy[1] + (l.dy ?? 0)} text-anchor={l.anchor ?? "start"} font-size="13" font-weight="500" fill="var(--ink)" paint-order="stroke" stroke="var(--land)" stroke-width="4">{l.label}</text>
    ))}
  </svg>
  {!fill && <figcaption class="body-6 muted">{c.source}</figcaption>}
</figure>

<script>
  import { startMap } from "./course-map";
  // Standalone (race without 3D scene) at once, as 3D placeholder only when the page reports the fallback.
  for (const fig of document.querySelectorAll<HTMLElement>("[data-live-map]")) {
    if (!fig.closest("#stage")) startMap(fig);
  }
  document.addEventListener("stage-fallback", () => {
    for (const fig of document.querySelectorAll<HTMLElement>("#stage [data-live-map]")) startMap(fig);
  });
</script>

<style>
  .map { margin: 0; display: flex; flex-direction: column; gap: var(--s100); }
  svg { width: 100%; height: auto; display: block; border-radius: 24px; border: 1px solid var(--line); background: var(--land); }
  .fill { width: 100%; height: 100%; }
  .fill svg { height: 100%; border: 0; border-radius: 0; }
  text { font-family: var(--f-body); }
  .mono { font-family: var(--f-mono); }
  .map :global(.spot-name) { font-size: 12px; font-weight: 500; }
  /* Live map: text keeps its size on screen however small the map is drawn (--k from course-map.ts, like mapK in the legacy). */
  [data-live-map] text:not(.mono) { font-size: calc(13px * var(--k, 1)); stroke-width: calc(4px * var(--k, 1)); }
  /* On the phone only the landmarks marked for it, like the legacy map. */
  @media (max-width: 640px) {
    .wide-only { display: none; }
  }
</style>
