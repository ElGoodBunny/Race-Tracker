---
// Status card "Wo ist Dima?" (docs/tasks/027-claude-statuskarte.md). Markup and look from the status card in
// legacy/hamburg-2026.html, the numbers from the estimate on Supabase data. Holds the sighting button like the legacy card.
// It sits under the 3D view, not next to it (docs/decisions/2026-11-25-statuskarte.md).
import Seen from "./Seen.astro";

interface Props {
  slug: string;
  timezone: string;
  plannedStart: string;
  targetSec: number;
  distanceKm: number;
  netSec?: number;
}
const { slug, timezone, plannedStart, targetSec, distanceKm, netSec } = Astro.props;
const plan = { plannedStart, targetSec, distanceKm, netSec };
---

<section class="live-sec status" id="status" aria-labelledby="status-h" data-slug={slug} data-tz={timezone} data-plan={JSON.stringify(plan)}>
  <div class="card status-card">
    <div class="now">
      <div class="card-head">
        <h3 id="status-h" class="title-1">Wo ist Dima?</h3>
        <span class="caption-4 muted mono" id="status-clock"></span>
      </div>
      <span class="pill caption-4" id="status-pill"><span class="dot"></span><span id="status-phase">Lädt</span></span>
      <p class="bignum heading-1"><span class="mono" id="status-big">·</span><small id="status-unit"></small></p>
      <div class="bar" aria-hidden="true"><div class="fill" id="status-fill"></div></div>
    </div>
    <div class="more">
      <dl class="stats" id="status-stats"></dl>
      <p class="basis body-6" id="status-basis"></p>
      <Seen slug={slug} plannedStart={plannedStart} targetSec={targetSec} distanceKm={distanceKm} netSec={netSec} />
    </div>
  </div>
</section>

<script>
  import { startStatus } from "./status";
  const root = document.getElementById("status");
  if (root) startStatus(root);
</script>

<style>
  .status { padding-top: 0; }
  .status-card { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s300) var(--s600); }
  .now, .more { display: flex; flex-direction: column; gap: var(--s200); min-width: 0; }
  .card-head { display: flex; justify-content: space-between; align-items: center; gap: var(--s100); }
  .card-head h3 { margin: 0; }
  .muted { color: var(--muted); }
  .pill { align-self: flex-start; }
  .bignum { margin: 0; letter-spacing: -0.03em; white-space: nowrap; }
  .bignum .mono { font-variant-numeric: tabular-nums; }
  .bignum small { font-size: 18px; line-height: 28px; font-weight: 500; margin-left: var(--s75); color: var(--muted); letter-spacing: 0; }
  .bar { position: relative; height: 8px; border-radius: 4px; background: var(--route-todo); overflow: hidden; }
  .bar .fill { position: absolute; inset: 0; background: var(--route); transform: scaleX(0); transform-origin: left center; transition: transform var(--t-move) var(--ease); }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s100); margin: 0; }
  .stats :global(dt) { color: var(--muted); font-size: 12px; line-height: 16px; font-weight: 500; }
  .stats :global(dd) { margin: 0; font-family: var(--f-mono); font-variant-numeric: tabular-nums; white-space: nowrap; font-size: 20px; line-height: 28px; font-weight: 500; }
  .basis { margin: 0; color: var(--muted); display: flex; gap: var(--s75); align-items: center; flex-wrap: wrap; }
  .basis :global(b) { color: var(--ink); font-weight: 600; }
  .basis :global(.chip) { display: inline-flex; align-items: center; padding: var(--s25) var(--s75); border-radius: 9999px; background: var(--surface-2); border: 1px solid var(--line); font-size: 12px; line-height: 16px; font-weight: 500; }
  .basis :global(.chip.official) { color: var(--good); border-color: color-mix(in srgb, var(--good) 40%, transparent); }
  .basis :global(.chip.seen) { color: var(--route); border-color: color-mix(in srgb, var(--route) 40%, transparent); }
  .basis :global(.chip.plan) { color: var(--warn); border-color: color-mix(in srgb, var(--warn) 40%, transparent); }
  @media (max-width: 900px) {
    .status-card { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 400px) {
    .bignum { font-size: 48px; line-height: 48px; }
    .stats :global(dd) { font-size: 16px; line-height: 24px; }
  }
</style>
