---
// Floating navigation with the current section and a full height menu below 900 px (docs/tasks/033-claude-navigation.md).
// Markup and look from .nav-wrap and #mnav in legacy/hamburg-2026.html, glass as in docs/DESIGN.md.
// The main action is kept current by hero.ts, like the one in the hero.
interface Props {
  brand: string;
  cta: { label: string; href: string };
}
const { brand, cta } = Astro.props;
const links = [
  { id: "live", label: "Live" },
  { id: "spots", label: "An der Strecke" },
  { id: "pinnwand", label: "Pinnwand" },
  { id: "ergebnis", label: "Zeiten" },
  { id: "faq", label: "FAQ" },
];
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Hauptnavigation">
    <a class="brand title-3" href="#hero" aria-label={`${brand}, zum Anfang`}>
      <svg class="ico" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128,64a40,40,0,1,0,40,40A40,40,0,0,0,128,64Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,128,128Zm0-112a88.1,88.1,0,0,0-88,88c0,31.4,14.51,64.68,42,96.25a254.19,254.19,0,0,0,41.45,38.3,8,8,0,0,0,9.18,0A254.19,254.19,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25A88.1,88.1,0,0,0,128,16Zm0,206c-16.53-13-72-60.75-72-118a72,72,0,0,1,144,0C200,161.23,144.53,209,128,222Z"></path></svg>
      <span>{brand}</span>
    </a>
    <ul class="nav-links">
      {links.map((l) => <li><a class="title-4" href={`#${l.id}`} data-spy={l.id}>{l.label}</a></li>)}
    </ul>
    <a class="nav-cta button-sm" data-cta href={cta.href}><span data-cta-label>{cta.label}</span></a>
    <button class="menu-toggle" type="button" id="menu-toggle" aria-expanded="false" aria-controls="mnav" aria-label="Menü öffnen"><i></i><i></i></button>
  </nav>
</header>
<div class="mnav" id="mnav" hidden>
  <ul>
    {links.map((l) => <li><a href={`#${l.id}`}>{l.label}</a></li>)}
  </ul>
</div>

<script>
  import { startNav } from "./nav";
  startNav();
</script>

<style>
  .nav-wrap { position: fixed; top: calc(var(--s200) + env(safe-area-inset-top, 0px)); left: 0; right: 0; z-index: 70; display: flex; justify-content: center; padding-inline: calc(var(--s200) + env(safe-area-inset-left, 0px)) calc(var(--s200) + env(safe-area-inset-right, 0px)); pointer-events: none; }
  .nav { pointer-events: auto; display: flex; align-items: center; gap: var(--s200); padding: var(--s75) var(--s75) var(--s75) var(--s200); border-radius: 9999px; border: 1px solid var(--line); background: var(--nav-bg); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); box-shadow: var(--shadow); }
  .brand { display: flex; align-items: center; gap: var(--s75); color: var(--ink); text-decoration: none; white-space: nowrap; }
  .brand .ico { width: 20px; height: 20px; color: var(--signal); }
  .nav-links { display: flex; gap: var(--s50); list-style: none; margin: 0; padding: 0; }
  .nav-links a { display: block; padding: var(--s50) var(--s100); border-radius: 9999px; color: var(--muted); text-decoration: none; transition: background-color var(--t-color) var(--ease), color var(--t-color) var(--ease); }
  .nav-links a:hover, .nav-links a[aria-current="true"] { color: var(--ink); background: var(--surface-2); }
  .nav-cta { display: inline-flex; align-items: center; padding: var(--s50) var(--s100); border-radius: 9999px; background: var(--ink); color: var(--bg); text-decoration: none; white-space: nowrap; }
  .nav-cta:hover { background: color-mix(in srgb, var(--ink) 82%, var(--bg)); }
  .menu-toggle { display: none; position: relative; width: 40px; height: 40px; border: 0; border-radius: 9999px; background: transparent; cursor: pointer; transition: background-color var(--t-color) var(--ease); }
  .menu-toggle:hover { background: var(--surface-2); }
  .menu-toggle i { position: absolute; left: 12px; right: 12px; height: 2px; border-radius: 2px; background: var(--ink); transition: transform var(--t-move) var(--ease); }
  .menu-toggle i:first-child { top: 15px; }
  .menu-toggle i:last-child { top: 23px; }
  .menu-toggle[aria-expanded="true"] i:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] i:last-child { transform: translateY(-4px) rotate(-45deg); }
  .mnav { position: fixed; inset: 0; z-index: 65; background: var(--menu-bg); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); padding: calc(var(--s900) + env(safe-area-inset-top, 0px)) var(--s300) var(--s400); opacity: 0; transition: opacity var(--t-move) var(--ease); }
  .mnav[hidden] { display: none; }
  .mnav:global(.open) { opacity: 1; }
  .mnav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--s75); }
  .mnav a { display: block; padding: var(--s100) 0; color: var(--ink); text-decoration: none; font-size: 30px; line-height: 36px; font-weight: 600; opacity: 0; transform: translateY(24px); transition: opacity var(--t-move) var(--ease), transform var(--t-move) var(--ease); }
  .mnav:global(.open) a { opacity: 1; transform: none; }
  .mnav:global(.open) li:nth-child(2) a { transition-delay: 40ms; }
  .mnav:global(.open) li:nth-child(3) a { transition-delay: 80ms; }
  .mnav:global(.open) li:nth-child(4) a { transition-delay: 120ms; }
  .mnav:global(.open) li:nth-child(5) a { transition-delay: 160ms; }
  /* Anchors land below the floating bar. */
  :global(main [id]) { scroll-margin-top: var(--s900); }
  @media (max-width: 900px) {
    .nav-links, .nav-cta { display: none; }
    .menu-toggle { display: block; }
    .nav { width: 100%; max-width: 560px; justify-content: space-between; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle i, .mnav, .mnav a { transition: none; }
  }
</style>
