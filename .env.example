# Supabase project (Settings > API). The anon key is public by design, security comes from RLS.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Cloudflare Turnstile (CAPTCHA beim ersten Schreiben). Der Site Key ist öffentlich, der Secret Key gehört nur ins Supabase-Dashboard.
PUBLIC_TURNSTILE_SITE_KEY=YOUR-SITE-KEY
